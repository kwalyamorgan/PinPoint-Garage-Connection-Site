PORT=4000
JWT_SECRET=change-me
# Optional: create initial admin on first run
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secret123
FRONTEND_ORIGIN=http://localhost:5173
# create DB and user (you'll be prompted for password)
sudo -u postgres psql -c "CREATE DATABASE pinpoint;"
sudo -u postgres psql -c \"CREATE USER pinpoint_user WITH PASSWORD 'yourpassword';\"
sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE pinpoint TO pinpoint_user;"

# set env for this shell (or add to .env)
export DATABASE_URL=postgresql://pinpoint_user:yourpassword@localhost:5432/pinpoint
export ADMIN_EMAIL=admin@example.com
export ADMIN_PASSWORD=secret123